# Hub CRM backend. Hallway talks to it through a same-origin /api/crm proxy
# that authenticates server-side, so corridor pages do not ask visitors to log in.
CRM_API_PROXY_TARGET=http://localhost:8081

# Optional Hub service account. If unset, the proxy uses SUPER_ADMIN user id 1
# (Hub tokens are token_{userId}_{millis}).
# CRM_USERNAME=admin
# CRM_PASSWORD=admin123
# CRM_SHOWCASE_USER_ID=1

# Hub CRM backend. Hallway talks to it through a same-origin /api/crm proxy
# so corridor pages do not ask visitors to log in, and the browser never
# requests /v1/hallway/* from Hub directly.
#
# Teammates: Project-ERP must be running with Hallway showcase APIs, or point this
# at a shared Hub:
CRM_API_PROXY_TARGET=http://127.0.0.1:8081

# Optional Hub service account. If unset, Hallway tries admin/admin123 then SUPER_ADMIN id 1.
# CRM_USERNAME=admin
# CRM_PASSWORD=admin123
# CRM_SHOWCASE_USER_ID=1

# Design Module backend (login API)
DESIGN_MODULE_BASE_URL=

# Design Module Next.js UI (where the user lands after login handoff)
DESIGN_MODULE_FRONTEND_URL=
NEXT_PUBLIC_DESIGN_MODULE_FRONTEND_URL=
